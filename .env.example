# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- PostgreSQL (docker-compose service "postgres", host port 5433) ---
POSTGRES_USER=astraquant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astraquant
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis (docker-compose service "redis", host port 6380) ---
REDIS_URL=redis://localhost:6380/0

# --- App ---
JWT_SECRET=generate-with-python-secrets-token_urlsafe-48
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
LIVE_TRADING_ENABLED=false     # must stay false; see ARCHITECTURE.md §8

# --- Upstox (Developer Console → My Apps). Required for live data (Phase 2/5). ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback

# Fernet key used to encrypt broker access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
